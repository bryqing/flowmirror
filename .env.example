# ============================================================================
# FlowMirror 环境变量模板
#
# 本地开发：复制为 .env.local 并填入真实值（.env.local 已被 .gitignore 忽略，不会提交）
# 线上部署：在 Netlify 控制台
#           Site configuration → Environment variables 中逐条添加，
#           作用域请同时勾选 Builds / Functions / Runtime。
#
# ⚠️ 缺少这些变量时：页面能正常打开，但 AI 凝练、黑洞锦囊、云同步会静默失败
#    （表现为「已展示预置文案」或一直停留在未同步）。
# ============================================================================

# ---- Supabase ----
# 浏览器端可见，因此必须以 NEXT_PUBLIC_ 开头才会被注入到客户端包中。
# ANON KEY 受 RLS 保护，可以公开；切勿把 service_role key 放在这里。
#
# ⚠️ 该 URL 还是同源反向代理的上游地址（服务端使用，运行时读取）：
#   浏览器 → /api/supabase/<path> → src/app/api/supabase/[...path]/route.ts → 该 URL
#   用于绕开国内直连 supabase.co 被阻断（ERR_CONNECTION_CLOSED）。
#   缺失时 /api/supabase/* 会返回带 supabase_proxy_not_configured 的 500。
#
#   作用域请同时勾选 **Builds / Functions / Runtime**：
#     - Builds    → NEXT_PUBLIC_ 变量要被内联进客户端包
#     - Functions → 代理 Route Handler 在运行时读取上游地址
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- DeepSeek ----
# 服务端密钥，仅在 Netlify Functions（/api/ai/* 路由）中读取。
# 绝不要加 NEXT_PUBLIC_ 前缀，否则会被打包进浏览器 JS 造成泄露。
DEEPSEEK_API_KEY=
